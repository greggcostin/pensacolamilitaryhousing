/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# De-index the *.pages.dev twin (canonical + JS redirect alone do not stop crawlers)
https://greggcostin.pages.dev/*
  X-Robots-Tag: noindex

# Photos: stable filenames, 30-day cache (site convention; rename to bust)
/images/*
  Cache-Control: public, max-age=2592000
# OG cards: short TTL so a regenerated card is not invisible for a month (og-01)
/og/*
  Cache-Control: public, max-age=86400
