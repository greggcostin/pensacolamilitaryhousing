# Cloudflare Pages security & caching headers.
# Site-wide defaults first; long-cache for hashed/static assets at the bottom.

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=(), payment=(), usb=(), magnetometer=(), gyroscope=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://*.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://*.gregg-costin.workers.dev https://www.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; media-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://*.gregg-costin.workers.dev; upgrade-insecure-requests

# Hashed Vite output — safe to cache for a year
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Image assets — long cache; filenames change when images change
/images/*
  Cache-Control: public, max-age=31536000, immutable

# Per-page Open Graph images — long cache
/og/*
  Cache-Control: public, max-age=31536000, immutable

# Manifest + favicon — moderate cache
/site.webmanifest
  Cache-Control: public, max-age=86400
/favicon.ico
  Cache-Control: public, max-age=86400

# llms.txt is a content map — short cache so updates propagate
/llms.txt
  Cache-Control: public, max-age=3600
/llms-full.txt
  Cache-Control: public, max-age=3600
